# ===========================================
# GitHub Omni Agent - Environment Variables
# ===========================================
# این فایل را کپی کنید به .env و مقادیر واقعی را پر کنید
# هرگز فایل .env را در گیت‌هاب آپلود نکنید

# 1) Google AI Studio (Gemini) - رایگان
# از این آدرس بگیرید: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2) GitHub Personal Access Token (Classic)
# از این آدرس بسازید: https://github.com/settings/tokens
# دسترسی‌های لازم: repo, workflow, read:org, gist
GITHUB_TOKEN=your_github_token_here
